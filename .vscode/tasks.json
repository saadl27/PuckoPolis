{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Make TP2 Exercise",
            "type": "shell",
            "command": "${config:make_path} -j",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "options": {
                "cwd": "${workspaceFolder}/src/"
            }
        },
        {
            "label": "Clean TP2 Exercise",
            "type": "shell",
            "command": "${config:make_path} clean",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/src/"
            }
        },
        {
            "label": "Link Librairy ST to TP2 Exercise",
            "type": "shell",
            "command": "if [ -d \"ST\" ]; then echo -n -e '\\033[1;32m'Link ST already present !; echo '\\033[0m'; echo ; else ln -s ${config:workplace}/Lib/ST ${workspaceFolder}/. ; fi",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }

    ]
}