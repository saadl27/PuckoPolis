{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "TP2 Exercise: Make",
            "type": "shell",
            "command": "${config:make_path} -j",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "options": {
                "cwd": "${workspaceFolder}/src/"
            },
            "presentation": {
                "echo": false,
            }
        },
        {
            "label": "TP2 Exercise: Clean",
            "type": "shell",
            "command": "${config:make_path} clean",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/src/"
            },
            "presentation": {
                "echo": false,
            }
        },
        {
            "label": "TP2 Exercise:(Link Library ST)",
            "type": "shell",
            "command": "if [ -d \"ST\" ]; then echo -n -e '\\033[0;91m'Link ST already present !; echo '\\033[0m'>>/dev/null; else ln -s ${config:workplace}/Lib/ST . ; echo -n -e '\\033[1;32m'Link ST done !; echo '\\033[0m'>>/dev/null; fi; echo '\n'",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": false,
            }
        }
    ]
}